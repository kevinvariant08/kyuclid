{
  "name": "kyuclid",
  "private": true,
  "type": "module",
  "description": "Kyuclid: a ranked dojo for contest maths. The site is static files; these scripts manage the problem data.",
  "scripts": {
    "build": "node scripts/build-index.mjs",
    "validate": "node scripts/validate.mjs",
    "hash": "node scripts/hash-answer.mjs",
    "review": "node scripts/review-server.mjs",
    "digest": "node scripts/rejection-digest.mjs",
    "test:review": "node --test scripts/review-server.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "mathjax-full": "^3.2.2"
  }
}
